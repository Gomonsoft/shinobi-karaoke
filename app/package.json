{
  "name": "shinobi-karaoke",
  "version": "0.1.0",
  "description": "Software libre y gratuito para crear y reproducir karaokes",
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Gomonsoft",
    "email": "contacto@gomonsoft.com"
  },
  "homepage": "https://github.com/Gomonsoft/shinobi-karaoke",
  "repository": "https://github.com/Gomonsoft/shinobi-karaoke",
  "desktopName": "shinobi-karaoke.desktop",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "cross-env SHINOBI_DATOS=.datos-dev electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "semilla": "cross-env SHINOBI_DATOS=.datos-dev node --experimental-transform-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/semilla.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:cobertura": "vitest run --coverage --coverage.include=src/shared/** --coverage.exclude=src/shared/**/*.test.ts --coverage.exclude=src/shared/__fixtures__/**"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@electron/fuses": "2.1.3",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "cross-env": "^10.1.0",
    "electron": "^45.2.2",
    "electron-builder": "26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "license-checker-rseidelsohn": "5.0.1",
    "lucide-react": "^1.68.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
